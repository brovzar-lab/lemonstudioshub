generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  image       String?
  role        Role      @default(DEV_TEAM)
  accounts    Account[]
  sessions    Session[]
  projects    Project[] @relation("ProjectOwner")
  assignments Assignment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String          @id @default(cuid())
  title           String
  format          Format
  logline         String?
  stage           Stage           @default(INBOX)
  health          Health          @default(ON_TRACK)
  healthOverride  Boolean         @default(false)
  sensitivity     Sensitivity     @default(VISIBLE_ALL)
  ownerId         String?
  owner           User?           @relation("ProjectOwner", fields: [ownerId], references: [id])
  blocker         String?
  nextAction      String?
  nextActionDue   DateTime?
  nextActionOwner String?
  assignments     Assignment[]
  documents       Document[]
  coverages       Coverage[]
  decisions       Decision[]
  activityLog     ActivityEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Document {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id])
  versions  DocumentVersion[]
  createdAt DateTime          @default(now())
}

model DocumentVersion {
  id          String     @id @default(cuid())
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id])
  versionNum  Int
  objectKey   String     @unique
  filename    String
  mimeType    String
  sizeBytes   Int
  checksum    String?
  uploaderId  String
  isCanonical Boolean    @default(false)
  scanState   ScanState  @default(UNVERIFIED)
  coverages   Coverage[]
  createdAt   DateTime   @default(now())
}

model Coverage {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id])
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id])
  readerId          String
  verdict           Verdict?
  summary           String?          @db.Text
  notes             String?          @db.Text
  requestedAt       DateTime         @default(now())
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
}

model Decision {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  type        DecisionType
  outcome     String
  rationale   String?      @db.Text
  deciderId   String
  effectiveAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
}

model Assignment {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String
  accountable Boolean   @default(false)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
}

model ActivityEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  actorId   String
  action    String
  entity    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

enum Role {
  PARTNER
  HOD
  DEV_TEAM
  ADMIN
}

enum Format {
  FEATURE
  LIMITED_SERIES
  RETURNING_SERIES
  SHORT
}

enum Stage {
  INBOX
  TRIAGE
  READING
  DEVELOPMENT
  PACKAGING
  PITCHING
  SUBMITTED
  PASSED
  DORMANT
  WITHDRAWN
  GREENLIT
  ARCHIVED
}

enum Health {
  ON_TRACK
  AT_RISK
  BLOCKED
  STALE
}

enum Sensitivity {
  VISIBLE_ALL
  HIDDEN_ALL
}

enum ScanState {
  UNVERIFIED
  CLEAN
  QUARANTINED
  EXTRACTED
  EXTRACTION_FAILED
}

enum Verdict {
  PASS
  CONSIDER
  RECOMMEND
}

enum DecisionType {
  STAGE_ADVANCE
  PROJECT_PASS
  REVIVAL
  PACKAGING_APPROVAL
  PITCH_GO_AHEAD
  CANON_CHANGE
  RESOURCE_COMMITMENT
}
